# Supabase (Auth + PostgreSQL + RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # CHỈ dùng ở server, KHÔNG public

# Lưu trữ file: Backblaze B2 qua API tương thích S3 (bắt buộc khi deploy lên
# Vercel — Vercel Functions không có ổ đĩa ghi được lâu dài).
# Lấy các giá trị này trong B2 Console:
#   B2_KEY_ID / B2_APPLICATION_KEY : App Keys > Add a New Application Key
#                                     (giới hạn quyền vào đúng 1 bucket bên dưới)
#   B2_BUCKET                      : tên bucket đã tạo (private)
#   B2_ENDPOINT / B2_REGION        : Bucket Details > Endpoint, VD:
#                                     s3.us-west-004.backblazeb2.com -> region us-west-004
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=meeting-system-storage
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Thông báo đẩy (Web Push) — báo cho người dùng khi được cử tham dự cuộc họp mới.
# Tạo cặp khoá bằng lệnh (chạy trong thư mục dự án):
#   npx web-push generate-vapid-keys
# Dán "Public Key" và "Private Key" vào đúng 2 dòng dưới đây.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY được đưa vào cả code chạy trên trình duyệt (bắt
# buộc, để trình duyệt đăng ký nhận push) — đây LÀ khoá công khai, an toàn khi lộ.
# VAPID_PRIVATE_KEY thì ngược lại, phải giữ bí mật tuyệt đối như SERVICE_ROLE_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kbnn-kvvii.gov.vn
